# Protect data in the legacy workspace/ folder. Only its README is tracked.
workspace/*
!workspace/README.md
# Copies of the workspace ("workspace copy", "workspace-old"…)
/workspace?*/

# Personal files that could land in the project root by mistake
/*.pdf
/*.doc
/*.docx
/*.odt
/*.csv
/*.png
/*.jpg
CLAUDE.local.md

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local Claude Code settings (per-user)
.claude/settings.local.json
